<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BetterMoonSweeper</AssemblyName>
    <RootNamespace>BetterMoonSweeper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Pasta do jogo; sobrescreva com: dotnet build -p:GameDir="D:\outro\caminho" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</GameDir>
    <!-- Build de diagnóstico (logs extras): dotnet build -c Release -p:Diagnostico=true -->
    <DefineConstants Condition="'$(Diagnostico)' == 'true'">$(DefineConstants);DIAGNOSTICO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 (IL2CPP) e Harmony -->
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />

    <!-- Gerados pelo patcher na primeira execução do jogo (Assembly-CSharp, UnityEngine, etc.) -->
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <!-- Depois de compilar, copia a DLL para a pasta de plugins do BepInEx -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins" />
    <!-- Com o jogo aberto a DLL fica travada: avisa em vez de falhar o build -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" Retries="0" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_DllCopiada" />
    </Copy>
    <Message Importance="high" Condition="'@(_DllCopiada)' != ''" Text="BetterMoonSweeper copiado para $(GameDir)\BepInEx\plugins" />
    <Warning Condition="'@(_DllCopiada)' == ''" Text="BetterMoonSweeper NÃO foi copiado para $(GameDir)\BepInEx\plugins (o jogo está aberto?)" />
  </Target>

</Project>
