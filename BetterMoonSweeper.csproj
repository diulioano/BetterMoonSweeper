<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BetterMoonSweeper</AssemblyName>
    <RootNamespace>BetterMoonSweeper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Pasta do jogo; sobrescreva com: dotnet build -p:GameDir="D:\outro\caminho" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</GameDir>
    <!-- Build de diagnóstico (logs extras): dotnet build -c Release -p:Diagnostico=true -->
    <DefineConstants Condition="'$(Diagnostico)' == 'true'">$(DefineConstants);DIAGNOSTICO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- MelonLoader e Harmony -->
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />

    <!-- Gerados pelo MelonLoader na primeira execução do jogo (Assembly-CSharp, UnityEngine, etc.) -->
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <!-- Depois de compilar, copia a DLL para a pasta Mods do jogo -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\MelonLoader')">
    <MakeDir Directories="$(GameDir)\Mods" />
    <!-- Com o jogo aberto a DLL fica travada: avisa em vez de falhar o build -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" Retries="0" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_JonasCopiado" />
    </Copy>
    <Message Importance="high" Condition="'@(_JonasCopiado)' != ''" Text="BetterMoonSweeper copiado para $(GameDir)\Mods" />
    <Warning Condition="'@(_JonasCopiado)' == ''" Text="BetterMoonSweeper NÃO foi copiado para $(GameDir)\Mods (o jogo está aberto?)" />
  </Target>

</Project>
